     KE_MSG_SEND(rsp);
 }
+
+#ifdef DEMO_ATTRACT
+/****************************************************************************************/
+// Demo attract loop (bring-up builds only).
+//
+// Boot paints frame 0 immediately and each minute tick advances one frame
+// (same content as host_test/seed_demo.json, ASCII only: the panel fonts have
+// no Vietnamese glyphs), so the panel re-renders step by step with no phone
+// attached. The header clock is live (hour/minute globals).
+//
+// Rules: the loop starts on every boot (even with a stored image); after that
+// an OTA in progress or uploaded-image mode win (no paint, no advance).
+// 0x93 mode 1 shows the stored image (pausing the demo), 0x93 mode 0 resumes
+// it. The first time sync hands the screen back to the clock face (the
+// minute tick owns the screen once synced). Demo builds sacrifice the
+// pairing QR screen (web-picker pairing still works); production builds
+// drop -DDEMO_ATTRACT.
+// B/W only: the red plane is phase 2 (see PORT_CHECKLIST.md phase D).
+/****************************************************************************************/
+
+static const char *demo_dist[6] = {
+	"READY",
+	"84 km",
+	"500 m",
+	"150 m",
+	"0 m",
+	"DONE",
+};
+
+static const char *demo_line1[6] = {
+	"DEMO - NAV",
+	"Di thang ve huong",
+	"Re phai ve huong",
+	"Re phai vao",
+	"Den noi:",
+	"TRIP",
+};
+
+static const char *demo_line2[6] = {
+	"STEPS",
+	"cao toc HN-HP",
+	"Vo Thi Sau",
+	"Vo Thi Sau",
+	"123 Vo Thi Sau",
+	"LOOP",
+};
+
+int demo_nframes(void) { return 6; }
+
+// Returns 1 if painted, 0 if skipped (OTA in progress or panel still busy
+// with the previous update -- the next tick retries, so a stuck BUSY stalls
+// the demo instead of re-initing the controller mid-frame and wedging it).
+int demo_draw(int step)
+{
+	LAYOUT *lt = &layouts[current_layout];
+	int xres = lt->xres, yres = lt->yres;
+	int cx = xres/2;
+	char head[16], tag[12];
+
+	step %= demo_nframes();
+	if(step < 0) step += demo_nframes();
+
+	if(ota_state) return 0;
+	if(epd_busy()) return 0;
+
+	sprintf(head, "%02d:%02d", hour, minute);
+	sprintf(tag, "NAV %d/6", step+1);
+
+	fb_clear();
+
+	/* Header: live time left, frame counter right. */
+	draw_text(4, 2, head, BLACK);
+	{
+		int w = text_width(tag);
+		draw_text(xres-4-w, 2, tag, BLACK);
+	}
+	draw_hline(yres*20/104, 0, xres-1, BLACK);
+
+	/* Hero: distance, scale 3 (~42 px on sfont). */
+	draw_text_scaled_centered(cx, yres*26/104, (char*)demo_dist[step], 3, BLACK);
+
+	/* Instruction, pre-split into two scale-1 lines (~14 px each). */
+	draw_text_centered(cx, yres*70/104, (char*)demo_line1[step], BLACK);
+	draw_text_centered(cx, yres*86/104, (char*)demo_line2[step], BLACK);
+
+	epd_hw_open();
+	epd_update_mode(UPDATE_FULL);
+	epd_commit();
+	return 1;
+}
+#endif
