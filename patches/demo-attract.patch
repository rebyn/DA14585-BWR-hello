@@ -362,6 +378,24 @@
  *        timer to fire exactly on that boundary
  ****************************************************************************************
  */
+#ifdef DEMO_ATTRACT
+// Demo frame timer: paint the next frame, then re-arm. OTA and
+// uploaded-image mode win (skip without advancing); the first time
+// sync hands the screen back to the clock face and stops the demo.
+static void demo_timer_cb(void)
+{
+	if(!ota_state && display_mode!=1){
+		if(cal_minute>=0){
+			app_easy_timer_cancel(demo_timer_used);
+			return;
+		}
+		demo_draw(demo_step % demo_nframes());
+		demo_step++;
+	}
+	demo_timer_used = app_easy_timer(DEMO_TICK_S*100, demo_timer_cb);
+}
+#endif
+
 void app_clock_timer_restart(void)
 {
 	app_easy_timer_cancel(app_clock_timer_used); // Cancel the current timer
@@ -410,10 +444,21 @@
