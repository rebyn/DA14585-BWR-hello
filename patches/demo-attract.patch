+	// shows it (pausing the demo); 0x93 mode 0 hands the screen back to the
+	// demo while unsynced, clock face once synced.
+	display_mode = 0;
+	demo_draw(0);
+	demo_step = 1;
+	demo_timer_used = app_easy_timer(DEMO_TICK_S*100, demo_timer_cb);
