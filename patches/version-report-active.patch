diff -ruN --exclude=.git ancestor/src/epd/spi_flash.c /tmp/anc-v2/src/epd/spi_flash.c
--- ancestor/src/epd/spi_flash.c	2026-10-15 04:49:35
+++ /tmp/anc-v2/src/epd/spi_flash.c	2026-10-15 20:53:35
@@ -601,9 +601,20 @@
 
 		// Best-effort diagnostics: expose the A/B image versions and slot
 		// addresses (product header if valid, defaults otherwise).
+		// [20..23] carries the RUNNING image version: the booter picks the
+		// newest-valid slot, so after a good OTA slot 0 still holds the stale
+		// vendor header (version 0) while the new build runs from slot 1.
+		// Reporting slot 0 unconditionally made every good update read "v0".
 		product_slots(image_addr);
-		sf_read(image_addr[0]+28, 4, (u8*)flash_diag+20);
-		sf_read(image_addr[1]+28, 4, (u8*)flash_diag+24);
+		sf_read(image_addr[0], 32, pbuf);
+		sf_read(image_addr[1], 32, pbuf+32);
+		{
+			int flag0 = (pbuf[0]==0x70 && pbuf[1]==0x51 && pbuf[2]==0xaa) ? (signed char)pbuf[3] : -1;
+			int flag1 = (pbuf[32]==0x70 && pbuf[33]==0x51 && pbuf[34]==0xaa) ? (signed char)pbuf[35] : -1;
+			int act = pick_active_image(flag0, flag1);
+			sf_read(image_addr[act]+28, 4, (u8*)flash_diag+20);
+			sf_read(image_addr[act^1]+28, 4, (u8*)flash_diag+24);
+		}
 		flash_diag_set(28, image_addr[0]);
 		flash_diag_set(30, image_addr[1]&0xffff);
 	}
